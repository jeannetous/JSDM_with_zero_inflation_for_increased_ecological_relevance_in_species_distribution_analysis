em.normalblock <- function(Y, X, w, Q, niter=50, getRmse=FALSE, trueB=0,
trueSigmaQ=0, trueDm=0, easyInit = FALSE,
coeffEasyInit = 0.9, perturbationEasyInit = FALSE) {
# Rq: LL is in fact an ELBO here
LL_list <- c()
if(getRmse){
rmseB_list <- c()
rmseSigmaQ_list <- c()
rmseDm_list <- c()
}
n <- ncol(Y)
p <- nrow(Y)
wbar <- sum(w)
# Initialisations à vérifier
if(easyInit){
B <- coeffEasyInit * trueB
dm <- coeffEasyInit * trueDm
SigmaQ <- coeffEasyInit * trueSigmaQ
residuals <- Y - t(B) %*% X
clusters <- kmeans(residuals, Q)$cluster
tau <- t(as_indicator(clusters))
M <- t(residuals) %*% t(tau)
S <- matrix(rep(0, n * Q), nrow=n)
for(q in 1:Q){
qIndices = which(clusters == q)
qResiduals = residuals[qIndices,]
for(i in 1:n){
if(length(qIndices) <= 1){
S[i, q] = 1e-3
}else{
S[i, q] = sqrt(var(qResiduals[,i]))
}
}
}
tau[tau == 0] <- 1e-5
alpha <- table(clusters) / length(clusters)
if(perturbationEasyInit){
B <- B + matrix(rnorm(p * d), nrow = d)
dm <- dm + rnorm(length(dm))
SigmaQ <- SigmaQ + matrix(rnorm(Q * Q), nrow = Q)
}
}else{
B <- as.matrix(solve(X %*% t(X)) %*% X %*% t(Y))
residuals <- Y - t(B) %*% X
clusters <- kmeans(residuals, Q)$cluster
tau <- t(as_indicator(clusters))
M <- t(residuals) %*% t(tau)
S <- matrix(rep(0, n * Q), nrow=n)
for(q in 1:Q){
qIndices = which(clusters == q)
qResiduals = residuals[qIndices,]
for(i in 1:n){
if(length(qIndices) <= 1){
S[i, q] = 1e-3
}else{
S[i, q] = sqrt(var(qResiduals[,i]))
}
}
}
emp_cov <- cov(t(residuals))
SigmaQ <- tau %*% emp_cov %*% t(tau)
tau[tau == 0] <- 1e-5
dm <- as.vector(rep(1, p))
alpha <- table(clusters) / length(clusters)
}
for(h in 1:niter){
# if(h == 15){browser()}
# print(h)
B <- as.matrix(solve(X %*% diag(w) %*% t(X)) %*% X %*% diag(w) %*% (t(Y) - M %*% tau))
SigmaQ <- (1/ wbar) * (t(M) %*% diag(w) %*% M + diag(as.vector(t(S**2)%*%w)))
SigmaQM <- solve(SigmaQ)
M <- (t(Y - t(B) %*% X) %*% diag(as.vector(dm)) %*% t(tau)) %*% solve(diag(as.vector(t(dm) %*%t(tau))) + SigmaQM)
S <- 1 / sqrt(as.vector(rep(1, n)) %*%  t(diag(SigmaQM)))
rho = (1/wbar) * (-0.5 * t(M**2) %*% w %*% t(as.vector(rep(1, p))) %*% diag(as.vector(dm)) + t(M) %*% diag(w) %*% t((Y - t(B) %*% X)) %*% diag(as.vector(dm))) - matrix(rep(1, Q*p), nrow=Q) + log(alpha) %*% t(as.vector(rep(1, p)))
rhoMMax <- apply(rho, 2, function(row){return(row - max(abs(row)))})
exprho <- exp(rhoMMax)
tau <-   t(apply(exprho, 1, function(row){return(row / colSums(exprho))}))
alpha <- rowMeans(tau)
d <- (1/wbar) * (((Y - t(B) %*% X)**2) - 2*(Y - t(B) %*% X) * (t(tau) %*% t(M)) +  t(tau) %*% t(M**2)) %*% w
# d <- (1/wbar) * ((Y - t(B) %*% X - t(tau) %*% t(M))**2) %*% w
dm <- 1/d
LL <- - wbar * ((p + Q)/2) * log(2 * pi) + (wbar * Q / 2) * log(2 * pi * exp(1)) - 0.5 * wbar * sum(log(d)) - 0.5 * as.vector(rep(1, p)) %*% diag(as.vector(dm)) %*% ((Y - t(B) %*% X)**2) %*% w - 0.5 * as.vector(rep(1, p))  %*% diag(as.vector(dm)) %*% t(tau) %*% t(M**2) %*% w + as.vector(rep(1, p))  %*% diag(as.vector(dm)) %*% ((Y - t(B) %*% X) * (t(tau) %*% t(M))) %*% w - 0.5 * wbar * log(det(SigmaQ)) - 0.5 * t(w) %*% ((M %*% SigmaQM) * M) %*% as.vector(rep(1, Q)) - 0.5 * t(w) %*% (S**2) %*% diag(SigmaQM) + 0.5 * w %*% log(S**2) %*% as.vector(rep(1, Q)) +  wbar * ( t(log(alpha)) %*% tau - t(as.vector(rep(1, Q))) %*% (apply(tau, c(1,2), xlogx))) %*% as.vector(rep(1, p))
LL_list <- c(LL_list, LL)
if(getRmse){
rmseB_list <- c(rmseB_list, rmse(trueB, B))
rmseSigmaQ_list <- c(rmseSigmaQ_list, rmse(trueSigmaQ, SigmaQ))
rmseDm_list <- c(rmseDm_list, rmse(trueDm, dm))
}
}
nb.param <- length(B) + p + (Q * (Q + 1))/2
AIC <- -2*LL + 2*nb.param
BIC <- -2*LL + log(n)*nb.param
if(getRmse){
return(list(B=B, SigmaQ=SigmaQ, dm=dm, alpha=alpha, tau=tau, M=M, S=S, LL_list=LL_list,
LL=c(logLik=LL_list[[length(LL_list)]], AIC=AIC, BIC=BIC),
rmseB = rmseB_list, rmseSigmaQ=rmseSigmaQ_list, rmseDm=rmseDm_list))
}else{
return(list(B=B, SigmaQ=SigmaQ, dm=dm, alpha=alpha, tau=tau, M=M, S=S, LL_list=LL_list,
LL=c(logLik=LL_list[[length(LL_list)]], AIC=AIC, BIC=BIC)))
}
}
test_em <- em.normalblock(Y, X, w, Q, niter=50, getRmse=TRUE, trueB=B,
trueSigmaQ=SigmaQ, trueDm=Dm, easyInit = FALSE,
coeffEasyInit = 1, perturbationEasyInit = FALSE)
